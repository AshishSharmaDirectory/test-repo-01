@Metadata.layer: #CORE
annotate entity ZC_ITEM02_N with
{

  @UI.facet: [
  {
  purpose: #STANDARD,
  type: #IDENTIFICATION_REFERENCE,
  label: 'Items',
  position: 10
  } ]
  ItemId;

