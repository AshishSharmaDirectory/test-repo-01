managed implementation in class zbp_r_item02_n unique;
strict ( 2 );
with draft;
define behavior for ZR_ITEM02_N alias item
persistent table zitem02_n
draft table zitem02_n_d
lock master
total etag LastChangedAt
etag master LastChangedAt
authorization master ( instance )
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly, numbering : managed ) ItemId;

  //  Apply Actions, Custom button
  // Get Feature Instance is for Disabling the button on UI based on condn
  action ( features : instance ) updStatus result [1] $self;

  draft action Activate optimized;
  draft action Edit;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare { }

  //  Apply validations
  validation ValidatePrice on save { field Price; create; }

  //  Apply Determinations
  //  determination ProductPrice on save { field Name; create; }

  //  Apply Side effect, so that changes are visible on UI instantly after pressing Enter
  //  Commented the above Determination on Save so that Side effect can be tested
  determination ProductPrice on modify { field Name; create; }

  side effects { field Name affects field Price; }

  mapping for zitem02_n
    {
      ItemId             = item_id;
      name               = name;
      Description        = description;
      Price              = price;
      StatusCode         = status_code;
      LastChangedAt      = last_changed_at;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedAt = local_last_changed_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalCreatedBy     = local_created_by;
    }
}